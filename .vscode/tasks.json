{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "House: Import Seed and Run Full Pipeline",
      "type": "shell",
      "command": "python3 import_house_model_seed.py && python3 run_house_full_pipeline.py",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": true
      },
      "group": {
        "kind": "build",
        "isDefault": true
      }
    },
    {
      "label": "House: Run Full Pipeline",
      "type": "shell",
      "command": "python3 run_house_full_pipeline.py",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": true
      }
    },
    {
      "label": "House: Commit and Push",
      "type": "shell",
      "command": "git status && git add . && git commit -m \"Update House model inputs and outputs\" && git push",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": true
      }
    },
    {
      "label": "House: Git Status",
      "type": "shell",
      "command": "git status",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": true
      }
    },
    {
      "label": "House: Open Dashboard",
      "type": "shell",
      "command": "python3 -m streamlit run dashboard_house_app.py",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": true
      }
    }
  ]
}
